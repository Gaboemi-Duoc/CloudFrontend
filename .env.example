# --- Vite dev proxy ---
VITE_BACKEND_URL=http://localhost:8080
VITE_GATEWAY_SECRET=secreto_local

# --- Cognito (must match the Spring Boot issuer URI) ---
# Issuer: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_NN6vjj3k5
VITE_COGNITO_CLIENT_ID=replace-with-your-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_LOGOUT_URI=http://localhost:5173

# --- Production API base URL (leave empty to use the dev proxy) ---
# VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com